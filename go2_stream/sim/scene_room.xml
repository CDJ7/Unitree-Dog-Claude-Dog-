<!-- Indoor test room for the Go2 MuJoCo sim. Edit freely.
     Conventions:
       * Angles are in RADIANS (the included go2.xml sets compiler angle="radian").
       * Any body named  obj_<class>_<n>  is a labelled object. Underscores in <class> become spaces
         (obj_dining_table_1 -> "dining table"). These feed the GROUND TRUTH mode and the accuracy check.
         Use COCO class names (chair, dining table, backpack, bottle, cup, book, ...) so YOLO can match them.
       * Room is x in [-3, 3], y in [-2.5, 2.5]; the robot starts near (-2.2, 0) facing +x.
     {{GO2_XML}} and {{BILLBOARDS}} are filled in by sim/world.py when the scene is built. -->
<mujoco model="go2 room">
  <include file="{{GO2_XML}}"/>

  <statistic center="0 0 0.5" extent="4"/>
  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.8 0.85" rgb2="0.3 0.3 0.35" width="512" height="3072"/>
    <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.62 0.55 0.45" rgb2="0.56 0.49 0.4"
             markrgb="0.45 0.4 0.32" width="300" height="300"/>
    <material name="r_floor" texture="floortex" texuniform="true" texrepeat="6 5" reflectance="0.05"/>
    <material name="r_wall" rgba="0.9 0.9 0.86 1"/>
    <material name="r_wood" rgba="0.55 0.36 0.2 1"/>
    <material name="r_darkwood" rgba="0.33 0.2 0.1 1"/>
    <material name="r_fabric_blue" rgba="0.2 0.3 0.7 1"/>
    <material name="r_fabric_red" rgba="0.7 0.12 0.12 1"/>
    <material name="r_cardboard" rgba="0.72 0.55 0.33 1"/>
    <material name="r_glass_green" rgba="0.2 0.6 0.3 1"/>
    <material name="r_plastic_white" rgba="0.95 0.95 0.95 1"/>
    <material name="r_black" rgba="0.08 0.08 0.08 1"/>
    {{BILLBOARD_ASSETS}}
  </asset>

  <worldbody>
    <light pos="0 0 2.3" dir="0 0 -1" directional="false" diffuse="0.5 0.5 0.5" castshadow="false"/>
    <light pos="-2 0 2.3" dir="0.3 0 -1" diffuse="0.3 0.3 0.3" castshadow="false"/>
    <geom name="floor" type="plane" size="3 2.5 0.05" material="r_floor"/>

    <!-- walls -->
    <geom name="wall_n" type="box" pos="0 2.55 1.2" size="3.05 0.05 1.2" material="r_wall"/>
    <geom name="wall_s" type="box" pos="0 -2.55 1.2" size="3.05 0.05 1.2" material="r_wall"/>
    <geom name="wall_e" type="box" pos="3.05 0 1.2" size="0.05 2.5 1.2" material="r_wall"/>
    <geom name="wall_w" type="box" pos="-3.05 0 1.2" size="0.05 2.5 1.2" material="r_wall"/>

    <!-- dining table at the centre-right of the room -->
    <body name="obj_dining_table_1" pos="0.6 0 0">
      <geom type="box" pos="0 0 0.72" size="0.6 0.4 0.025" material="r_wood"/>
      <geom type="box" pos="0.52 0.32 0.35" size="0.03 0.03 0.35" material="r_darkwood"/>
      <geom type="box" pos="-0.52 0.32 0.35" size="0.03 0.03 0.35" material="r_darkwood"/>
      <geom type="box" pos="0.52 -0.32 0.35" size="0.03 0.03 0.35" material="r_darkwood"/>
      <geom type="box" pos="-0.52 -0.32 0.35" size="0.03 0.03 0.35" material="r_darkwood"/>
    </body>

    <!-- chairs (each: seat, back, 4 legs); back is on the +x side of its own frame, rotate to face the table -->
    <body name="obj_chair_1" pos="0.6 0.85 0" euler="0 0 -1.5708">
      <geom type="box" pos="0 0 0.45" size="0.22 0.22 0.02" material="r_fabric_blue"/>
      <geom type="box" pos="-0.2 0 0.72" size="0.02 0.22 0.25" material="r_fabric_blue"/>
      <geom type="box" pos="0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
    </body>
    <body name="obj_chair_2" pos="0.6 -0.85 0" euler="0 0 1.5708">
      <geom type="box" pos="0 0 0.45" size="0.22 0.22 0.02" material="r_fabric_red"/>
      <geom type="box" pos="-0.2 0 0.72" size="0.02 0.22 0.25" material="r_fabric_red"/>
      <geom type="box" pos="0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
    </body>
    <body name="obj_chair_3" pos="-0.6 0.1 0" euler="0 0 3.1416">
      <geom type="box" pos="0 0 0.45" size="0.22 0.22 0.02" material="r_fabric_blue"/>
      <geom type="box" pos="-0.2 0 0.72" size="0.02 0.22 0.25" material="r_fabric_blue"/>
      <geom type="box" pos="0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
      <geom type="box" pos="-0.18 -0.18 0.22" size="0.02 0.02 0.22" material="r_darkwood"/>
    </body>

    <!-- a cardboard box and a backpack on the floor -->
    <body name="obj_suitcase_1" pos="2.0 1.5 0">
      <geom type="box" pos="0 0 0.2" size="0.25 0.18 0.2" material="r_cardboard"/>
    </body>
    <body name="obj_backpack_1" pos="2.0 -1.4 0">
      <geom type="box" pos="0 0 0.22" size="0.14 0.1 0.22" material="r_fabric_red"/>
      <geom type="box" pos="0.1 0 0.12" size="0.05 0.08 0.1" material="r_black"/>
    </body>

    <!-- low side table with a bottle and a cup, plus a bottle on the floor -->
    <body name="side_table" pos="-1.2 1.8 0">
      <geom type="box" pos="0 0 0.2" size="0.3 0.25 0.02" material="r_darkwood"/>
      <geom type="box" pos="0.25 0.2 0.1" size="0.02 0.02 0.1" material="r_darkwood"/>
      <geom type="box" pos="-0.25 0.2 0.1" size="0.02 0.02 0.1" material="r_darkwood"/>
      <geom type="box" pos="0.25 -0.2 0.1" size="0.02 0.02 0.1" material="r_darkwood"/>
      <geom type="box" pos="-0.25 -0.2 0.1" size="0.02 0.02 0.1" material="r_darkwood"/>
    </body>
    <body name="obj_bottle_1" pos="-1.1 1.8 0.22">
      <geom type="cylinder" pos="0 0 0.1" size="0.035 0.1" material="r_glass_green"/>
      <geom type="cylinder" pos="0 0 0.225" size="0.015 0.03" material="r_glass_green"/>
    </body>
    <body name="obj_cup_1" pos="-1.3 1.75 0.22">
      <geom type="cylinder" pos="0 0 0.05" size="0.04 0.05" material="r_plastic_white"/>
    </body>
    <body name="obj_bottle_2" pos="1.5 -0.3 0">
      <geom type="cylinder" pos="0 0 0.1" size="0.035 0.1" material="r_glass_green"/>
      <geom type="cylinder" pos="0 0 0.225" size="0.015 0.03" material="r_glass_green"/>
    </body>

    {{BILLBOARDS}}
  </worldbody>
</mujoco>
